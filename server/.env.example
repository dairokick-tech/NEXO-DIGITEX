# API
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Base central de registro de empresas (ya creada por el administrador)
REGISTRY_DATABASE_URL=postgresql://registry_user:CHANGE_ME@localhost:5432/nova_registry

# Conexión administrativa PostgreSQL usada SOLO por el backend para CREATE DATABASE.
# No usar esta URL en frontend ni subir un .env real al repositorio.
DATABASE_ADMIN_URL=postgresql://provisioner:CHANGE_ME@localhost:5432/postgres

# Prefijo permitido para nombres de bases de datos generados por el servidor
TENANT_DB_PREFIX=nova_company_
