# API
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
PROVISIONING_SECRET=replace-with-a-random-secret-at-least-32-characters

# Base central de registro (crear primero ejecutando sql/registry.sql)
REGISTRY_DATABASE_URL=postgresql://registry_user:CHANGE_ME@localhost:5432/nova_registry

# Cuenta administrativa de PostgreSQL exclusiva del backend, con CREATEDB.
DATABASE_ADMIN_URL=postgresql://provisioner:CHANGE_ME@localhost:5432/postgres
TENANT_DB_PREFIX=nova_company_
PGSSL=false
